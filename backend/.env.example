PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shophub?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# SMTP pour la vérification des adresses email
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=ShopHub <no-reply@example.com>
MAIL_SSL_TLS=false
MAIL_STARTTLS=true

# Select sandbox for tests; use live only with a production key and deployment.
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SANDBOX_PUBLIC_KEY=
FEDAPAY_SANDBOX_SECRET_KEY=
FEDAPAY_LIVE_PUBLIC_KEY=
FEDAPAY_LIVE_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_SSL=true
